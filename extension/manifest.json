{
  "manifest_version": 3,
  "name": "Booru Prompt Gallery Sidebar",
  "version": "1.0.0",
  "description": "A pocket prompt assistant wrapper for Booru Prompt Gallery",
  "browser_specific_settings": {
    "gecko": {
      "id": "booru-prompt-gallery-sidebar@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "permissions",
    "downloads"
  ],
  "host_permissions": [
    "*://*.seaart.ai/*",
    "*://*.tensor.art/*",
    "*://*.tensorhub.net/*",
    "*://*.yodayo.com/*",
    "https://image.cdn2.seaart.me/*",
    "https://static.cdn.seaart.me/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' *://localhost:3000 *://127.0.0.1:3000; object-src 'self';"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Booru Prompt Gallery Sidebar",
    "default_icon": "icon.png"
  },
  "action": {
    "default_title": "Open Prompt Gallery Sidebar"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}